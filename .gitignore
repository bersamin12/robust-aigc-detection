# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Data: never commit imagery or derived banks ---
# Everything under data/ is acquired or generated: real datasets by
# scripts/acquire_data.py, synthetic fixtures by make_dummy_manifest.
# Ignore the whole tree rather than named subdirectories, so a stray
# `git add -A` can never commit gigabytes of imagery.
# Anchored to the repo root (leading slash): a bare `data/` also matches
# `src/aigcdet/data/` and `tests/data/` by basename at any depth, which
# silently hid new files added under those package directories (found while
# adding src/aigcdet/data/audit.py and tests/data/test_audit.py in Task 8;
# the pre-existing files there predate the rule that broke this).
/data/
*.parquet
*.npy
*.npz

# --- Feature banks and model artefacts ---
banks/
runs/
checkpoints/
*.pt
*.pth
*.safetensors
*.joblib

# --- Outputs that are regenerated, not authored ---
outputs/
figures/*.png
docs/contact_sheets/

# --- Local scratch ---
scratch/
*.log
.DS_Store

# --- Subagent-driven-development scratch (ledger, briefs, review packages) ---
.superpowers/

# agent worktrees (transient, created by the Agent tool)
.claude/worktrees/
