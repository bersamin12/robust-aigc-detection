# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Data: never commit imagery or derived banks ---
# Everything under data/ is acquired or generated: real datasets by
# scripts/acquire_data.py, synthetic fixtures by make_dummy_manifest.
# Ignore the whole tree rather than named subdirectories, so a stray
# `git add -A` can never commit gigabytes of imagery.
data/
*.parquet
*.npy
*.npz

# --- Feature banks and model artefacts ---
banks/
runs/
checkpoints/
*.pt
*.pth
*.safetensors
*.joblib

# --- Outputs that are regenerated, not authored ---
outputs/
figures/*.png
docs/contact_sheets/

# --- Local scratch ---
scratch/
*.log
.DS_Store

# --- Subagent-driven-development scratch (ledger, briefs, review packages) ---
.superpowers/
