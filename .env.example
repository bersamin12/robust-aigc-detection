# Copy to `.env`, fill in, and `source .env` before running the task 03 scripts.
# `.env` is gitignored; `.env.example` is not. Never put a real key in this file.
#
# Two keys cover everything:
#
#   OPENROUTER_API_KEY  three of four image generators (OpenAI, Google,
#                       Seedream) via the unified image API, AND the captioner
#                       in scripts/build_prompts.py.   https://openrouter.ai/keys
#   IDEOGRAM_API_KEY    Ideogram only -- it is not on OpenRouter.
#                       https://developer.ideogram.ai
#
# Both scripts are dry-run by default and need no key at all until you pass
# --execute, so you can rehearse the whole chain before creating either.

export OPENROUTER_API_KEY=
export IDEOGRAM_API_KEY=
